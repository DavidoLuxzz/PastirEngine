# za sad nema custom muzike
# kontrolisanje muzike:
# 'mus <streamID>' za pustanje
# 'silence <streamID> [millis=1000]' za linearno utisavanje koje traje za odredjeno vreme
# 'stopmus [streamID]' nasilno zaustavi muziku
# 'fademus <streamID> [millis=1000]' za linearni low taper fejd muzike

# pustanje sound efekata:
# 'snd <soundID> [gain=100] [pan=0] [speed=100]'

# komande za tok radnje/vremena:
# 'sleep <millis>'

# 'attack {'  - registruje jedan attack
# '}' - kraj attacka
# Fight sistem nasumicno bira koji ce od ovih attackova da performuje

# napadi
# 'blasth <x> <y>' - horizontalni blast
# 'blastv <x> <y>' - vertikalni blast
# 'orb <x> <y>'


# komande za debug:
# 'print ...'








# prvi program u PFF-u   :D

# ovo je pre-fight section

room 1
spawn 100 100

stopmus
mus 2

print init hello

attacks:

{
# orb 100 100
blasth 100 100
sleep 100
blastv 100 100
sleep 1500
}

{
# shake <strength> <frequency> <seconds>
shake 100 10 1
sleep 1000
}
